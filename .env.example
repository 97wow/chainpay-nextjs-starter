# Database
DATABASE_URL=postgresql://...

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional, can use email/password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ChainPay (get from chainpay.pro/dashboard)
CHAINPAY_API_KEY=sk_live_your_api_key
CHAINPAY_WEBHOOK_SECRET=whsec_your_app_webhook_secret
CHAINPAY_BASE_URL=https://chainpay.pro

# Opt in only after operator fixed-address BSC receiving is configured for this merchant.
CHAINPAY_BEP20_ENABLED=0

# Opt in only after the ChainPay merchant has matching fixed receiving routes.
CHAINPAY_EVM_ENABLED_CHAINS=
